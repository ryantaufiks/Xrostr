{
  "name": "@xrostr/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xrostr/contracts": "workspace:*",
    "@xrostr/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pino": "^10.4.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@xrostr/config": "workspace:*",
    "pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
