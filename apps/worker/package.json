{
  "name": "@inroster/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inroster/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@inroster/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
