{
  "name": "@xrostr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@xrostr/contracts": "workspace:*",
    "@xrostr/country-id": "workspace:*",
    "@xrostr/country-sg": "workspace:*",
    "@xrostr/db": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^5.3.1",
    "otpauth": "^9.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@xrostr/config": "workspace:*",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "pg": "^8.23.1",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
