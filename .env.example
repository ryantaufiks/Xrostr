# Owner role: runs migrations, owns tables. Never used by the running app.
DATABASE_OWNER_URL=postgres://xrostr_owner:xrostr_owner_dev@127.0.0.1:5440/xrostr
# App role: subject to Row Level Security. Created by the first migration.
DATABASE_URL=postgres://xrostr_app:xrostr_app_dev@127.0.0.1:5440/xrostr
# Password assigned to xrostr_app by `pnpm db:migrate`.
DATABASE_APP_PASSWORD=xrostr_app_dev

API_HOST=127.0.0.1
API_PORT=8015
# Disable only in automated tests.
RATE_LIMIT_ENABLED=true
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ISSUER=xrostr
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# 32 random bytes, base64. Encrypts TOTP secrets and other sensitive columns.
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Seed: first platform superadmin
SEED_SUPERADMIN_EMAIL=superadmin@xrostr.local
# 16+ characters. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# To change it later: update this value, then run `pnpm db:superadmin-password`.
SEED_SUPERADMIN_PASSWORD=
